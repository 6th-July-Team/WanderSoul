  _backgroundSprites: []
  _statusText: {fileID: 7102048218594794717}
  _statusDotText: {fileID: 8307660327571487929}
  _statusMessages:
  - "\uB9C8\uCC28 \uBC14\uD034\uC5D0 \uAE30\uB984\uCE60\uD558\uB294 \uC911"
  - "\uD638\uC704 \uACBD\uB85C\uB97C \uD655\uC778\uD558\uB294 \uC911"
  - "\uD3AB\uB4E4\uC744 \uAE68\uC6B0\uB294 \uC911"
  - "\uC18C\uC6B8\uC744 \uC815\uC81C\uD558\uB294 \uC911"
  - "\uD559\uC790\uC758 \uB9C8\uBC95\uC11C\uB97C \uD3BC\uCE58\uB294 \uC911"
  - "\uBAAC\uC2A4\uD130\uC5D0\uAC8C \uCD9C\uADFC \uC2DC\uAC04\uC744 \uC54C\uB9AC\uB294

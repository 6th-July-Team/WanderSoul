  _tipText: {fileID: 1901614440007205675}
  _tips:
  - "\uB9C8\uCC28 \uB0B4\uAD6C\uB3C4\uAC00 0\uC774 \uB418\uBA74 \uC784\uBB34\uC5D0
    \uC2E4\uD328\uD569\uB2C8\uB2E4."
  - "\uD3AB\uC740 \uC18D\uC131\uC5D0 \uB530\uB77C \uAC15\uC810\uACFC \uC57D\uC810\uC774
    \uC788\uC5B4\uC694."
  - "\uC18C\uC6B8\uC744 \uBAA8\uC544 \uC0C8\uB85C\uC6B4 \uD3AB\uC744 \uB9CC\uB4DC\uC138\uC694."
  - "\uB9C8\uCC28\uC5D0\uC11C \uB108\uBB34 \uBA40\uC5B4\uC9C0\uBA74 \uACBD\uACE0\uAC00
    \uB739\uB2C8\uB2E4."
  - "\uB9C8\uCC28\uB97C \uC9C0\uD0A4\uB294 \uAC8C \uCD5C\uC6B0\uC120\uC785\uB2C8\uB2E4."
  - "\uB808\uBCA8\uC774 \uC624\uB974\uBA74 \uAC15\uD654 \uCE74\uB4DC\uB97C \uACE0\uB97C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC801\uC5D0\uAC8C\uB294 \uC18D\uC131\uBCC4 \uC800\uD56D\uC774 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uACB0\uACC4\uB294 \uBC94\uC704 \uC548 \uC544\uAD70\uC774 \uBC1B\uB294 \uD53C\uD574\uB97C
    \uB300\uC2E0 \uD761\uC218\uD569\uB2C8\uB2E4."
  - "\uC18C\uC6B8\uC758 \uACF5\uBA85\uC744 \uC4F0\uBA74 \uD3AB\uB4E4\uC774 \uC7A0\uAE50
    \uC544\uC8FC \uAC15\uD574\uC9D1\uB2C8\uB2E4."
  - "\uC758\uB8B0\uB97C \uC131\uACF5\uD558\uBA74 \uBA85\uC131\uC774 \uC624\uB985\uB2C8\uB2E4."
